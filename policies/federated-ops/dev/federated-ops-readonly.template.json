{
  "Statement": [
    {
      "Action": [
        "ecs:ListClusters",
        "ecs:ListTaskDefinitions",
        "ecs:ListTaskDefinitionFamilies",
        "ecs:DescribeTaskDefinition",
        "logs:DescribeLogGroups",
        "codebuild:ListProjects",
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "cn-north-1"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "RegionalDiscoveryAndMetrics"
    },
    {
      "Action": [
        "ecs:ListServices",
        "ecs:ListTasks"
      ],
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws-cn:ecs:cn-north-1:REPLACE_ME_ACCOUNT_ID:cluster/az-cn-rdit-aiec-ecs-fargate-dev"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ListProjectServicesAndTasks"
    },
    {
      "Action": [
        "ecs:DescribeClusters"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:ecs:cn-north-1:REPLACE_ME_ACCOUNT_ID:cluster/az-cn-rdit-aiec-ecs-fargate-dev"
      ],
      "Sid": "DescribeProjectCluster"
    },
    {
      "Action": [
        "ecs:DescribeServices"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:ecs:cn-north-1:REPLACE_ME_ACCOUNT_ID:service/az-cn-rdit-aiec-ecs-fargate-dev/az-cn-rdit-aiec-backend-dev",
        "arn:aws-cn:ecs:cn-north-1:REPLACE_ME_ACCOUNT_ID:service/az-cn-rdit-aiec-ecs-fargate-dev/az-cn-rdit-aiec-frontend-ext-dev",
        "arn:aws-cn:ecs:cn-north-1:REPLACE_ME_ACCOUNT_ID:service/az-cn-rdit-aiec-ecs-fargate-dev/az-cn-rdit-aiec-frontend-int-dev"
      ],
      "Sid": "DescribeProjectServices"
    },
    {
      "Action": [
        "ecs:DescribeTasks"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:ecs:cn-north-1:REPLACE_ME_ACCOUNT_ID:task/az-cn-rdit-aiec-ecs-fargate-dev/*"
      ],
      "Sid": "DescribeProjectTasks"
    },
    {
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/ecs/az-cn-rdit-aiec-backend-dev:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/ecs/az-cn-rdit-aiec-frontend-ext-dev:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/ecs/az-cn-rdit-aiec-frontend-int-dev:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/aws/codebuild/az-cn-rdit-aiec-backend-build-dev:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/aws/codebuild/az-cn-rdit-aiec-frontend-ext-build-dev:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/aws/codebuild/az-cn-rdit-aiec-frontend-int-build-dev:*"
      ],
      "Sid": "ReadProjectLogGroups"
    },
    {
      "Action": [
        "logs:GetLogEvents"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/ecs/az-cn-rdit-aiec-backend-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/ecs/az-cn-rdit-aiec-frontend-ext-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/ecs/az-cn-rdit-aiec-frontend-int-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/aws/codebuild/az-cn-rdit-aiec-backend-build-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/aws/codebuild/az-cn-rdit-aiec-frontend-ext-build-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:REPLACE_ME_ACCOUNT_ID:log-group:/aws/codebuild/az-cn-rdit-aiec-frontend-int-build-dev:log-stream:*"
      ],
      "Sid": "ReadProjectLogStreams"
    },
    {
      "Action": [
        "codebuild:BatchGetProjects",
        "codebuild:ListBuildsForProject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:codebuild:cn-north-1:REPLACE_ME_ACCOUNT_ID:project/az-cn-rdit-aiec-backend-build-dev",
        "arn:aws-cn:codebuild:cn-north-1:REPLACE_ME_ACCOUNT_ID:project/az-cn-rdit-aiec-frontend-ext-build-dev",
        "arn:aws-cn:codebuild:cn-north-1:REPLACE_ME_ACCOUNT_ID:project/az-cn-rdit-aiec-frontend-int-build-dev"
      ],
      "Sid": "DescribeProjectBuilds"
    },
    {
      "Action": [
        "codebuild:BatchGetBuilds"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:codebuild:cn-north-1:REPLACE_ME_ACCOUNT_ID:build/az-cn-rdit-aiec-backend-build-dev:*",
        "arn:aws-cn:codebuild:cn-north-1:REPLACE_ME_ACCOUNT_ID:build/az-cn-rdit-aiec-frontend-ext-build-dev:*",
        "arn:aws-cn:codebuild:cn-north-1:REPLACE_ME_ACCOUNT_ID:build/az-cn-rdit-aiec-frontend-int-build-dev:*"
      ],
      "Sid": "ReadProjectBuildResults"
    },
    {
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:ecr:cn-north-1:REPLACE_ME_ACCOUNT_ID:repository/REPLACE_ME_ECR_BACKEND",
        "arn:aws-cn:ecr:cn-north-1:REPLACE_ME_ACCOUNT_ID:repository/REPLACE_ME_ECR_FRONTEND_EXT",
        "arn:aws-cn:ecr:cn-north-1:REPLACE_ME_ACCOUNT_ID:repository/REPLACE_ME_ECR_FRONTEND_INT"
      ],
      "Sid": "InspectProjectImages"
    }
  ],
  "Version": "2012-10-17"
}
