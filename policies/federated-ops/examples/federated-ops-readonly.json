{
  "Statement": [
    {
      "Action": [
        "ecs:ListClusters",
        "ecs:ListTaskDefinitions",
        "ecs:ListTaskDefinitionFamilies",
        "ecs:DescribeTaskDefinition",
        "logs:DescribeLogGroups",
        "codebuild:ListProjects",
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "cn-north-1"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "RegionalDiscoveryAndMetrics"
    },
    {
      "Action": [
        "ecs:ListServices",
        "ecs:ListTasks"
      ],
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws-cn:ecs:cn-north-1:123456789012:cluster/az-cn-rdit-example-ecs-fargate-dev"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ListProjectServicesAndTasks"
    },
    {
      "Action": [
        "ecs:DescribeClusters"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:ecs:cn-north-1:123456789012:cluster/az-cn-rdit-example-ecs-fargate-dev"
      ],
      "Sid": "DescribeProjectCluster"
    },
    {
      "Action": [
        "ecs:DescribeServices"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:ecs:cn-north-1:123456789012:service/az-cn-rdit-example-ecs-fargate-dev/az-cn-rdit-example-backend-dev",
        "arn:aws-cn:ecs:cn-north-1:123456789012:service/az-cn-rdit-example-ecs-fargate-dev/az-cn-rdit-example-frontend-ext-dev",
        "arn:aws-cn:ecs:cn-north-1:123456789012:service/az-cn-rdit-example-ecs-fargate-dev/az-cn-rdit-example-frontend-int-dev"
      ],
      "Sid": "DescribeProjectServices"
    },
    {
      "Action": [
        "ecs:DescribeTasks"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:ecs:cn-north-1:123456789012:task/az-cn-rdit-example-ecs-fargate-dev/*"
      ],
      "Sid": "DescribeProjectTasks"
    },
    {
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/ecs/az-cn-rdit-example-backend-dev:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/ecs/az-cn-rdit-example-frontend-ext-dev:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/ecs/az-cn-rdit-example-frontend-int-dev:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/aws/codebuild/az-cn-rdit-example-backend-build-dev:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/aws/codebuild/az-cn-rdit-example-frontend-ext-build-dev:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/aws/codebuild/az-cn-rdit-example-frontend-int-build-dev:*"
      ],
      "Sid": "ReadProjectLogGroups"
    },
    {
      "Action": [
        "logs:GetLogEvents"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/ecs/az-cn-rdit-example-backend-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/ecs/az-cn-rdit-example-frontend-ext-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/ecs/az-cn-rdit-example-frontend-int-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/aws/codebuild/az-cn-rdit-example-backend-build-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/aws/codebuild/az-cn-rdit-example-frontend-ext-build-dev:log-stream:*",
        "arn:aws-cn:logs:cn-north-1:123456789012:log-group:/aws/codebuild/az-cn-rdit-example-frontend-int-build-dev:log-stream:*"
      ],
      "Sid": "ReadProjectLogStreams"
    },
    {
      "Action": [
        "codebuild:BatchGetProjects",
        "codebuild:ListBuildsForProject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:codebuild:cn-north-1:123456789012:project/az-cn-rdit-example-backend-build-dev",
        "arn:aws-cn:codebuild:cn-north-1:123456789012:project/az-cn-rdit-example-frontend-ext-build-dev",
        "arn:aws-cn:codebuild:cn-north-1:123456789012:project/az-cn-rdit-example-frontend-int-build-dev"
      ],
      "Sid": "DescribeProjectBuilds"
    },
    {
      "Action": [
        "codebuild:BatchGetBuilds"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:codebuild:cn-north-1:123456789012:build/az-cn-rdit-example-backend-build-dev:*",
        "arn:aws-cn:codebuild:cn-north-1:123456789012:build/az-cn-rdit-example-frontend-ext-build-dev:*",
        "arn:aws-cn:codebuild:cn-north-1:123456789012:build/az-cn-rdit-example-frontend-int-build-dev:*"
      ],
      "Sid": "ReadProjectBuildResults"
    },
    {
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:ecr:cn-north-1:123456789012:repository/example/backend",
        "arn:aws-cn:ecr:cn-north-1:123456789012:repository/example/frontend-ext",
        "arn:aws-cn:ecr:cn-north-1:123456789012:repository/example/frontend-int"
      ],
      "Sid": "InspectProjectImages"
    }
  ],
  "Version": "2012-10-17"
}
