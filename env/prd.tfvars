region      = "cn-north-1"
project     = "aiec"
environment = "prd"

mandatory_tags = {
  applicationname  = "AIEC Platform"
  applicationowner = "yongguo.he@astrazeneca.com"
  "Cost Center"    = "4109900005"
  "IDMD No"        = "CSE-13668"
  applicationid    = "SNSVC0008172"
  environment      = "prd"
  creationdate     = "xx/xx/2026" # Before deployment, enter the actual creation date in the format required by AZ. | 部署前按 AZ 要求填写实际创建日期。
}

# No automatic trigger; start builds manually or from an external pipeline. | 不自动触发，构建由人工或外部流水线发起。
log_retention_days = 365

# TLS certificate secret created outside Terraform; the module only references it and injects TLS_CERT / TLS_KEY. | TLS 证书的 Secret 由外部创建，本模板只引用并注入 TLS_CERT / TLS_KEY。
# The trailing six characters are generated by Secrets Manager; copy the full ARN from the console. | 结尾六位是 Secrets Manager 自动生成的，从控制台复制完整 ARN。
tls_secret_arn = "arn:aws-cn:secretsmanager:cn-north-1:332091793104:secret:aiec/personal/tls-REPLACE_ME"

# Create one S3 CMK and one CloudWatch Logs CMK per environment. Enter the IAM ARNs of AZ administrators and the actual deployment role. | 本模板创建每环境 S3 / CloudWatch Logs 两把 CMK。填 AZ 管理员及实际部署角色的 IAM ARN。
kms_administrator_arns = [
  "arn:aws-cn:iam::332091793104:role/REPLACE_ME", # 换成 AZ 密钥管理员和实际部署角色的角色名 | replace with the AZ key administrator and the actual deployment role
]

# Already supplied by AZ; share subnets and the security group with DEV and PPD. | AZ 已提供；与 DEV / PPD 共用子网和 SG。
subnet_ids = [
  "subnet-8c4c1efb",
  "subnet-0886d048a9ec36d81",
]

# Run exactly two tasks per service without Auto Scaling. | 三个服务固定各 2 个任务，不启用自动扩缩容。
# Initial ECS image: enter an existing yyyyMMddHHmmss tag (Asia/Shanghai). CodeBuild generates a new tag per build. | 初始 ECS 镜像填写已推送的北京时间戳 tag；CodeBuild 每次构建独立生成新 tag。
services = {
  "frontend-ext" = {
    cpu           = 1024 # 1 vCPU per task, with 2 tasks | 1 vCPU × 2 个任务
    memory        = 2048
    repository    = "az-cn-rdit-aiec-frontend-ext-prd"
    repo_url      = "https://github.com/AZU-RDIT/AIEC.git"
    buildspec     = "frontend-ext/buildspec.yml"
    branch        = "main"
    tag           = "REPLACE_ME_IMAGE_TAG"
    port          = 8443
    desired_count = 2

    security_group_ids = ["sg-0960c20f67f17cb68"]
    target_group_arn   = "arn:aws-cn:elasticloadbalancing:cn-north-1:REPLACE_ME:targetgroup/REPLACE_ME/REPLACE_ME"

    environment = {
      APP_ENV     = "prd"
      BACKEND_URL = "https://backend-service:8002"
    }

  }

  "frontend-int" = {
    cpu           = 1024
    memory        = 2048
    repository    = "az-cn-rdit-aiec-frontend-int-prd"
    repo_url      = "https://github.com/AZU-RDIT/AIEC.git"
    buildspec     = "frontend-int/buildspec.yml"
    branch        = "main"
    tag           = "REPLACE_ME_IMAGE_TAG"
    port          = 8443
    desired_count = 2

    security_group_ids = ["sg-0960c20f67f17cb68"]
    target_group_arn   = "arn:aws-cn:elasticloadbalancing:cn-north-1:REPLACE_ME:targetgroup/REPLACE_ME/REPLACE_ME"

    environment = {
      APP_ENV     = "prd"
      BACKEND_URL = "https://backend-service:8002"
    }

  }

  "backend" = {
    cpu        = 4096 # 4 vCPU per task, with 2 tasks | 4 vCPU × 2 个任务
    memory     = 8192
    repository = "az-cn-rdit-aiec-backend-prd"
    repo_url   = "https://github.com/AZU-RDIT/AIEC.git"
    buildspec  = "backend/buildspec.yml"
    branch     = "main"

    # The backend reads and writes the application file bucket; task role permissions are generated automatically. | 后端读写应用文件桶，任务角色权限自动生成。
    file_bucket_access = true
    tag                = "REPLACE_ME_IMAGE_TAG"
    port               = 8002
    desired_count      = 2

    security_group_ids   = ["sg-0960c20f67f17cb68"]
    service_connect_name = "backend-service"

    # Without an ALB health check, the container health check is the only health signal. | 没有 ALB 健康检查，容器健康检查是唯一的健康信号。
    # -k skips self-signed certificate verification; curl must be installed in the image. | -k 跳过自签证书校验；要求镜像里有 curl。
    health_check_command = "curl -fsSk https://localhost:8002/health || exit 1"

    environment = {
      APP_ENV = "prd"
    }

    # Map environment variable names to Secrets Manager ARNs; execution role permissions are scoped to these ARNs automatically. | 环境变量名 -> Secrets Manager ARN。执行角色权限自动按这里的 ARN 收口。
    # TLS is injected from tls_secret_arn; do not repeat it here. | TLS 由 tls_secret_arn 统一注入，不用在这里写。
    # Each ARN injects the whole secret JSON into one variable; append :key:: to pick a single JSON key instead. | 每个 ARN 把整段 JSON 注入一个变量；想只取其中一个键就在 ARN 后面接 :键名::。
    secrets = {
      BACKEND_RUNTIME = "arn:aws-cn:secretsmanager:cn-north-1:332091793104:secret:aiec/personal/backend-runtime-REPLACE_ME"
      DATABASE        = "arn:aws-cn:secretsmanager:cn-north-1:332091793104:secret:aiec/personal/database-REPLACE_ME"
    }

    # If these secrets use a CMK, also specify: | 这两个 Secret 若使用 CMK，还要填：
    # secrets_kms_key_arns = ["arn:aws-cn:kms:cn-north-1:332091793104:key/<key-id>"]
  }
}
